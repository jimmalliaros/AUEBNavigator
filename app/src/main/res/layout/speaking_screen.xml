<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/speaking_screen"
    android:background="@color/black"
    tools:context=".SpeakingScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageButton
        android:id="@+id/microphone_button"
        android:layout_width="110dp"
        android:layout_height="110dp"


        android:background="@drawable/circle"

        android:contentDescription="Microphone Button"
        android:scaleType="centerInside"

        android:src="@drawable/microphone"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/camera_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.908"
        app:tint="@color/black" />

    <ImageButton
        android:id="@+id/camera_button"
        android:layout_width="110dp"
        android:layout_height="110dp"


        android:layout_marginStart="160dp"
        android:background="@drawable/circle"

        android:contentDescription="Camera Button"

        android:scaleType="centerInside"

        android:src="@drawable/camera"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/microphone_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.908"
        app:tint="@color/black" />

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="110dp"
        android:layout_height="110dp"


        android:layout_marginStart="124dp"
        android:background="@drawable/circle"

        android:contentDescription="Settings Button"

        android:scaleType="centerInside"

        android:src="@drawable/setting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/camera_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.915"
        app:tint="@color/black" />

    <ImageButton
        android:id="@+id/speaking_microphone_button"
        android:layout_width="200dp"
        android:layout_height="200dp"


        android:background="@drawable/circle"
        android:contentDescription="Central_microphone Button"

        android:scaleType="centerInside"

        android:src="@drawable/noun_talking_4991708"


        app:layout_constraintBottom_toTopOf="@+id/camera_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.43"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.645"
        app:tint="@color/black" />


</androidx.constraintlayout.widget.ConstraintLayout>