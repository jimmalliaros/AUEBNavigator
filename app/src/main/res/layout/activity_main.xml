<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">


    <ImageButton
        android:id="@+id/microphone_button"
        android:layout_width="110dp"
        android:layout_height="110dp"

        android:layout_marginStart="64dp"


        android:background="@drawable/circle"

        android:contentDescription="Microphone Button"
        android:scaleType="centerInside"

        android:src="@drawable/microphone"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.909"
        app:tint="@color/black" />


    <ImageButton
        android:id="@+id/camera_button"
        android:layout_width="110dp"
        android:layout_height="110dp"


        android:layout_marginStart="40dp"

        android:background="@drawable/circle"
        android:contentDescription="Camera Button"

        android:scaleType="centerInside"

        android:src="@drawable/camera"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/microphone_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.909"
        app:tint="@color/black" />

    <ImageButton
        android:id="@+id/settings_button"
        android:layout_width="110dp"
        android:layout_height="110dp"


        android:layout_marginStart="16dp"

        android:background="@drawable/circle"
        android:contentDescription="Settings Button"

        android:scaleType="centerInside"

        android:src="@drawable/setting"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.439"
        app:layout_constraintStart_toEndOf="@+id/camera_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.908"
        app:tint="@color/black" />

    <ImageButton
        android:id="@+id/central_microphone_button"
        android:layout_width="200dp"
        android:layout_height="200dp"


        android:background="@drawable/circle"
        android:contentDescription="Central_microphone Button"

        android:scaleType="centerInside"

        android:src="@drawable/microphone"


        app:layout_constraintBottom_toTopOf="@+id/camera_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.542"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.821"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"


        android:layout_marginBottom="232dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="parent" />




</androidx.constraintlayout.widget.ConstraintLayout>